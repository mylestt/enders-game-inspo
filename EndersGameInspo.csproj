<Project Sdk="Godot.NET.Sdk/4.6.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <!-- The server-manager desktop tool is its own project (WPF, net10) — its sources
         must never be swept into the game assembly by the SDK's default glob. -->
    <Compile Remove="tools\server_manager\**\*.cs" />
  </ItemGroup>
</Project>