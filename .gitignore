# Godot-generated editor/import state.
/.godot/
/.mono/

# Local IDE state.
/.idea/
/.vs/
/.vscode/

# All exported games, packaging output, and local autosaves belong here.
/build/

# Blender autosaves and import metadata for editable source files.
*.blend1
/Resources/Source/**/*.import

# Legacy root export names are ignored if an old workflow recreates them.
/EndersGameInspo.exe
/EndersGameInspo.console.exe
/ZeroGravArena.exe
/ZeroGravArena.console.exe

# Server-manager compiler/publish output.
/tools/server_manager/EndersServerManager/bin/
/tools/server_manager/EndersServerManager/obj/
/tools/server_manager/publish/
