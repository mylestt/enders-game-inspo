# Godot 4+ editor cache and generated import data.
# Regenerated automatically by the editor — tracking it caused "phantom"
# git changes on every viewport move, Play press, or asset re-import.
.godot/

# Blender auto-save backups
*.blend1

# Import metadata for the raw Blender sources kept only for editing.
# The game uses the exported .glb files, not these .blend files directly,
# so Godot regenerates this on demand and it doesn't need tracking.
raw_blend/*.import

# Export binaries too large for GitHub (kept local; deploy via scp per DEPLOY.md)
/EndersGameInspo.exe
/EndersGameInspo.console.exe
/ZeroGravArena.exe
/ZeroGravArena.console.exe
build/enders_server.x86_64
build/mac/

# Steam build staging (300MB+ exports — far over GitHub's 100MB hard limit)
SteamBuilds/

# Server-manager tool build output (source is tracked; binaries are not)
tools/server_manager/EndersServerManager/bin/
tools/server_manager/EndersServerManager/obj/
tools/server_manager/publish/
